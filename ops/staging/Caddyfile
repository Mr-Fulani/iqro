{
	email {$STAGING_ACME_EMAIL}
	admin off
	http_port 8080
	https_port 8443
	servers :8443 {
		protocols h1 h2
	}
}

{$STAGING_HOST} {
	encode zstd gzip

	# Staging must never compete with the production domain in search results.
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@robots path /robots.txt
	header @robots Content-Type "text/plain; charset=utf-8"
	respond @robots <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200

	# Admin uploads of surahs, lesson videos and dubs answer only after the file is stored and checked.
	@long_upload path_regexp ^/admin/(audio/recitationedition/[^/]+/surahs|courses/courselesson/[^/]+/video(/dubs/[a-z]+)?)/upload/$
	reverse_proxy @long_upload gateway:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 600s
		}
	}

	reverse_proxy gateway:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}
