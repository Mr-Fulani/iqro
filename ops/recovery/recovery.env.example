# Copy to /etc/iqro/production-recovery.env with mode 0600; use systemd EnvironmentFile syntax.
# BACKUP_OBJECT_STORAGE_* reuse the existing private backup storage configuration.
BACKUP_ENVIRONMENT=production
BACKUP_DIR=/opt/quran/backups
BACKUP_OBJECT_STORAGE_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
BACKUP_OBJECT_STORAGE_BUCKET=replace-me-private-backups
BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
BACKUP_OBJECT_STORAGE_REGION=auto
BACKUP_OBJECT_STORAGE_ADDRESSING_STYLE=path
BACKUP_OBJECT_STORAGE_PREFIX=quran-platform/postgres
RECOVERY_STATUS_FILE=/opt/quran/backups/status/recovery.json
# Separate READ-ONLY credential for the working media bucket.
MEDIA_OBJECT_STORAGE_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
MEDIA_OBJECT_STORAGE_BUCKET=replace-me-media
MEDIA_OBJECT_STORAGE_ACCESS_KEY_ID=replace-me-media-access
MEDIA_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me-media-secret
MEDIA_OBJECT_STORAGE_REGION=auto
MEDIA_OBJECT_STORAGE_ADDRESSING_STYLE=path
