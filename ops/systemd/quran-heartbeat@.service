[Unit]
Description=IQRO %i external heartbeat and backup freshness check
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/quran/ops/monitoring/heartbeat.py
ConditionPathExists=/etc/iqro/%i-heartbeat.env

[Service]
Type=oneshot
WorkingDirectory=/opt/quran
EnvironmentFile=/etc/iqro/%i-heartbeat.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m ops.monitoring.heartbeat
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/quran
# Telegram alert state and the summary the admin shows (ops/monitoring/alerts.py);
# the backend container mounts this directory read-only.
StateDirectory=iqro-monitor/%i
StateDirectoryMode=0755
TimeoutStartSec=2m
