[Unit]
Description=IQRO %i PostgreSQL local and offsite backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/quran/Makefile

[Service]
Type=oneshot
WorkingDirectory=/opt/quran
EnvironmentFile=-/etc/iqro/%i-heartbeat.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock -n /run/lock/iqro-%i-backup.lock /usr/bin/make -C /opt/quran %i-backup-offsite
ExecStopPost=-/usr/bin/python3 -m ops.monitoring.heartbeat --job-result postgres
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
TimeoutStartSec=2h
