<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background" android:padding="14dp">
    <LinearLayout android:id="@+id/prayer_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/prayer_clock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="27" android:orientation="vertical" android:background="@drawable/prayer_clock_day" android:paddingVertical="3dp" android:paddingHorizontal="4dp" android:layoutDirection="ltr">
            <TextView android:id="@+id/next_hour" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:textSize="52sp" android:includeFontPadding="false" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="64sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/next_minute" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:textSize="52sp" android:includeFontPadding="false" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="64sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="29" android:orientation="vertical" android:layout_marginHorizontal="9dp" android:gravity="center" android:paddingVertical="4dp">
            <TextView android:id="@+id/next_name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="top|center_horizontal" android:textColor="#FFFFFF" android:textSize="24sp" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/countdown_label" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="20sp" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp" />
            <Chronometer android:id="@+id/prayer_countdown" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="match_parent" android:background="#66FFFFFF" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="44" android:layout_marginStart="9dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/fajr_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/fajr_time" android:layout_width="47dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/sunrise_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:textStyle="italic" />
            <TextView android:id="@+id/sunrise_time" android:layout_width="47dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/dhuhr_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/dhuhr_time" android:layout_width="47dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/asr_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/asr_time" android:layout_width="47dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/maghrib_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/maghrib_time" android:layout_width="47dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/isha_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/isha_time" android:layout_width="47dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:textDirection="ltr" android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/prayer_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="16sp" android:visibility="gone" />
</FrameLayout>
