<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/plan_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/prayer_widget_background" android:padding="14dp">
 <LinearLayout android:id="@+id/plan_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:layout_width="0dp" android:layout_weight="27" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/reading_plan_book" android:padding="7dp">
   <TextView android:id="@+id/plan_achieved" android:layout_width="match_parent" android:layout_height="0dp" android:textColor="#FFFFFF" android:textSize="48sp" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="48sp" android:autoSizeStepGranularity="1sp" android:layout_weight="1" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum"/>
   <TextView android:id="@+id/plan_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="17sp" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp" android:layoutDirection="ltr" android:textDirection="ltr"/>
   <TextView android:id="@+id/plan_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="3dp"/>
   <ProgressBar android:id="@+id/plan_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="10dp" android:progressTint="#EBC776" android:progressBackgroundTint="#665B4521" android:max="100" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="32" android:layout_height="match_parent" android:layout_marginHorizontal="9dp" android:orientation="vertical" android:gravity="center">
   <TextView android:id="@+id/plan_title" android:layout_width="match_parent" android:layout_height="0dp" android:textColor="#FFFFFF" android:textSize="22sp" android:gravity="center" android:maxLines="2" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:layout_weight="1"/>
   <TextView android:id="@+id/plan_remaining_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="6dp"/>
   <TextView android:id="@+id/plan_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="28sp" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:layout_marginTop="3dp" android:fontFeatureSettings="tnum"/>
   <TextView android:id="@+id/plan_remaining_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="3dp"/>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="match_parent" android:background="#66FFFFFF" android:importantForAccessibility="no"/>
  <LinearLayout android:id="@+id/plan_prayers" android:layout_width="0dp" android:layout_weight="41" android:layout_height="match_parent" android:layout_marginStart="9dp" android:orientation="vertical">
   <TextView android:id="@+id/plan_prayer_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="start" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:layout_marginBottom="4dp"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <TextView android:id="@+id/plan_fajr_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 <TextView android:id="@+id/plan_fajr_value" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layoutDirection="ltr" android:textDirection="ltr" android:textColor="#EBC776" android:textSize="14sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <TextView android:id="@+id/plan_dhuhr_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 <TextView android:id="@+id/plan_dhuhr_value" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layoutDirection="ltr" android:textDirection="ltr" android:textColor="#EBC776" android:textSize="14sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <TextView android:id="@+id/plan_asr_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 <TextView android:id="@+id/plan_asr_value" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layoutDirection="ltr" android:textDirection="ltr" android:textColor="#EBC776" android:textSize="14sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <TextView android:id="@+id/plan_maghrib_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 <TextView android:id="@+id/plan_maghrib_value" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layoutDirection="ltr" android:textDirection="ltr" android:textColor="#EBC776" android:textSize="14sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
 <TextView android:id="@+id/plan_isha_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 <TextView android:id="@+id/plan_isha_value" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layoutDirection="ltr" android:textDirection="ltr" android:textColor="#EBC776" android:textSize="14sp" android:maxLines="1" android:fontFeatureSettings="tnum" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout>
   <TextView android:id="@+id/plan_page_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="end" android:maxLines="1" android:includeFontPadding="false" android:ellipsize="end" android:layout_marginTop="3dp"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/plan_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="center_vertical|start" android:maxLines="3" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:visibility="gone"/>
</FrameLayout>
