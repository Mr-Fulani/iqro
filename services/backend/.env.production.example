# Copy to services/backend/.env.production, replace every replace-me value,
# and keep the resulting file outside version control (chmod 600).

APP_VERSION=0.1.0
SITE_URL=https://example.com
DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,backend,gateway
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_NUM_PROXIES=1
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=1048576
LOG_LEVEL=INFO

DATABASE_NAME=quran
DATABASE_USER=quran
DATABASE_PASSWORD=replace-me-with-a-random-database-password
DATABASE_CONN_MAX_AGE=60

PUBLIC_MEDIA_BASE_URL=https://example.com/media/
PUBLIC_AUDIO_BASE_URL=https://media.example.com/audio/

QURAN_INSTALLATION_HASH_KEY=replace-me-with-an-independent-random-secret
QURAN_GUEST_CREDENTIAL_HASH_KEY=replace-me-with-an-independent-random-secret
QURAN_REFRESH_TOKEN_HASH_KEY=replace-me-with-an-independent-random-secret
QURAN_EMAIL_CODE_HASH_KEY=replace-me-with-an-independent-random-secret
QURAN_PRAYER_THROTTLE_HASH_KEY=replace-me-with-an-independent-random-secret
QURAN_OPERATIONS_TOKEN=replace-me-with-an-independent-random-token

QURAN_ACCESS_TOKEN_TTL_SECONDS=900
QURAN_REFRESH_TOKEN_TTL_SECONDS=2592000
QURAN_GUEST_BOOTSTRAP_INSTALLATION_RATE=12/minute
QURAN_GUEST_BOOTSTRAP_IP_BURST_RATE=1200/minute
QURAN_TOKEN_REFRESH_SESSION_RATE=60/minute
QURAN_TOKEN_REFRESH_IP_BURST_RATE=6000/minute
QURAN_EMAIL_CODE_TTL_SECONDS=600
QURAN_EMAIL_CODE_ATTEMPTS=5
QURAN_EMAIL_CHALLENGE_RETENTION_HOURS=24
QURAN_ACCOUNT_DELETION_GRACE_DAYS=7
QURAN_ACCOUNT_REAUTH_MAX_AGE_SECONDS=600
QURAN_ACCOUNT_DELETION_BATCH_SIZE=100
QURAN_EMAIL_CHALLENGE_PRUNE_BATCH_SIZE=5000
QURAN_EMAIL_START_IDENTITY_RATE=5/hour
QURAN_EMAIL_START_IP_BURST_RATE=100/hour
QURAN_EMAIL_VERIFY_CHALLENGE_RATE=10/hour
QURAN_EMAIL_VERIFY_IP_BURST_RATE=300/hour
QURAN_FEEDBACK_WRITE_RATE=20/hour
QURAN_PRAYER_CALCULATE_RATE=60/minute
QURAN_PRAYER_PROFILE_MUTATION_RATE=60/minute
QURAN_READING_MUTATION_RATE=120/minute
QURAN_REMINDER_MUTATION_RATE=120/minute
QURAN_SYNC_PUSH_RATE=300/minute
QURAN_SYNC_PUSH_DAILY_RATE=5000/day

DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-me
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL="Quran Platform <noreply@example.com>"

QURAN_FEEDBACK_MAX_OPEN_TICKETS_PER_USER=20
QURAN_FEEDBACK_MAX_MESSAGES_PER_TICKET=100
QURAN_BOOKMARK_MAX_PER_USER=5000
QURAN_REMINDER_MAX_ACTIVE_PER_USER=64
QURAN_REMINDER_MAX_TOTAL_PER_USER=256
QURAN_RETIRED_BOOKMARK_ID_MAX_PER_USER=50000
QURAN_RETIRED_REMINDER_ID_MAX_PER_USER=50000

QURAN_AUTH_SESSION_RETENTION_DAYS=90
QURAN_AUTH_PRUNE_BATCH_SIZE=5000
QURAN_AUTH_PRUNE_TOKEN_BATCH_SIZE=50000
QURAN_RETENTION_TASK_MAX_BATCHES=10
QURAN_SYNC_CHANGE_RETENTION_DAYS=180
QURAN_SYNC_OPERATION_RETENTION_DAYS=180
QURAN_SYNC_PRUNE_BATCH_SIZE=5000
QURAN_SYNC_PRUNE_USER_BATCH_SIZE=1000
QURAN_BOOKMARK_TOMBSTONE_RETENTION_DAYS=365
QURAN_BOOKMARK_NEW_ID_MAX_AGE_DAYS=360
QURAN_BOOKMARK_ID_FUTURE_SKEW_SECONDS=86400
QURAN_REMINDER_TOMBSTONE_RETENTION_DAYS=365
QURAN_REMINDER_NEW_ID_MAX_AGE_DAYS=360
QURAN_REMINDER_ID_FUTURE_SKEW_SECONDS=86400
QURAN_REMINDER_PRUNE_BATCH_SIZE=5000
QURAN_SYNC_FULL_RESYNC_TOKEN_MAX_AGE_SECONDS=86400

QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=production
QF_AUDIO_SYNC_ENABLED=false
QF_AUDIO_REFRESH_DAYS=5
QF_AUDIO_STALE_AFTER_HOURS=168

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=3000
QURAN_MEDIA_DIR=./services/backend/media
QURAN_BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_FREE_MB=1024
BACKUP_FILE=
RESTORE_CHECK_DATABASE=quran_restore_check
RESTORE_DATABASE_NAME=
CONFIRM_RESTORE=
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
