DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=quran_backend.settings.local
DJANGO_SECRET_KEY=replace-for-non-local-environments
QURAN_INSTALLATION_HASH_KEY=replace-with-an-independent-random-secret
QURAN_GUEST_CREDENTIAL_HASH_KEY=replace-with-a-third-independent-random-secret
QURAN_REFRESH_TOKEN_HASH_KEY=replace-with-another-independent-random-secret
QURAN_EMAIL_CODE_HASH_KEY=replace-with-a-fifth-independent-random-secret
QURAN_PRAYER_THROTTLE_HASH_KEY=replace-with-a-fourth-independent-random-secret
QURAN_ACCESS_TOKEN_TTL_SECONDS=900
QURAN_REFRESH_TOKEN_TTL_SECONDS=2592000
QURAN_GUEST_BOOTSTRAP_INSTALLATION_RATE=12/minute
QURAN_GUEST_BOOTSTRAP_IP_BURST_RATE=1200/minute
QURAN_TOKEN_REFRESH_SESSION_RATE=60/minute
QURAN_TOKEN_REFRESH_IP_BURST_RATE=6000/minute
QURAN_EMAIL_CODE_TTL_SECONDS=600
QURAN_EMAIL_CODE_ATTEMPTS=5
QURAN_EMAIL_CHALLENGE_RETENTION_HOURS=24
QURAN_ACCOUNT_DELETION_GRACE_DAYS=7
QURAN_ACCOUNT_REAUTH_MAX_AGE_SECONDS=600
QURAN_ACCOUNT_DELETION_BATCH_SIZE=100
QURAN_EMAIL_CHALLENGE_PRUNE_BATCH_SIZE=5000
QURAN_EMAIL_START_IDENTITY_RATE=5/hour
QURAN_EMAIL_START_IP_BURST_RATE=100/hour
QURAN_EMAIL_VERIFY_CHALLENGE_RATE=10/hour
QURAN_EMAIL_VERIFY_IP_BURST_RATE=300/hour
QURAN_FEEDBACK_WRITE_RATE=20/hour
QURAN_PRAYER_CALCULATE_RATE=60/minute
QURAN_PRAYER_PROFILE_MUTATION_RATE=60/minute
QURAN_FEEDBACK_MAX_OPEN_TICKETS_PER_USER=20
QURAN_FEEDBACK_MAX_MESSAGES_PER_TICKET=100
QURAN_READING_MUTATION_RATE=120/minute
QURAN_REMINDER_MUTATION_RATE=120/minute
QURAN_REMINDER_MAX_ACTIVE_PER_USER=64
QURAN_REMINDER_MAX_TOTAL_PER_USER=256
QURAN_REMINDER_TOMBSTONE_RETENTION_DAYS=365
QURAN_REMINDER_NEW_ID_MAX_AGE_DAYS=360
QURAN_REMINDER_ID_FUTURE_SKEW_SECONDS=86400
QURAN_RETIRED_REMINDER_ID_MAX_PER_USER=50000
QURAN_REMINDER_PRUNE_BATCH_SIZE=5000
QURAN_SYNC_PUSH_RATE=300/minute
QURAN_SYNC_PUSH_DAILY_RATE=5000/day
QURAN_BOOKMARK_MAX_PER_USER=5000
QURAN_RETIRED_BOOKMARK_ID_MAX_PER_USER=50000
QURAN_AUTH_SESSION_RETENTION_DAYS=90
QURAN_AUTH_PRUNE_BATCH_SIZE=5000
QURAN_AUTH_PRUNE_TOKEN_BATCH_SIZE=50000
QURAN_RETENTION_TASK_MAX_BATCHES=10
QURAN_SYNC_CHANGE_RETENTION_DAYS=180
QURAN_SYNC_OPERATION_RETENTION_DAYS=180
QURAN_SYNC_PRUNE_BATCH_SIZE=5000
QURAN_SYNC_PRUNE_USER_BATCH_SIZE=1000
QURAN_BOOKMARK_TOMBSTONE_RETENTION_DAYS=365
QURAN_BOOKMARK_NEW_ID_MAX_AGE_DAYS=360
QURAN_BOOKMARK_ID_FUTURE_SKEW_SECONDS=86400
QURAN_SYNC_FULL_RESYNC_TOKEN_MAX_AGE_SECONDS=86400
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_NUM_PROXIES=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=quran
DATABASE_USER=quran
DATABASE_PASSWORD=quran-local-only
REDIS_URL=redis://redis:6379/0
# Optional role overrides. Empty values inherit REDIS_URL for local/backward-compatible use.
REDIS_CACHE_URL=
REDIS_THROTTLE_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BEAT_LOCK_KEY=quran-platform:celery-beat:lease
CELERY_BEAT_LOCK_TTL_SECONDS=60
CELERY_BEAT_LOCK_RENEW_INTERVAL_SECONDS=20
CELERY_BEAT_MAX_LOOP_INTERVAL_SECONDS=5
APP_VERSION=0.1.0
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media/
PUBLIC_AUDIO_BASE_URL=http://localhost:8000/media/
# Optional local S3-compatible emulator. Production settings require these values and HTTPS.
MEDIA_OBJECT_STORAGE_ENABLED=false
MEDIA_OBJECT_STORAGE_ALLOW_HTTP=false
MEDIA_OBJECT_STORAGE_ENDPOINT_URL=
MEDIA_OBJECT_STORAGE_BUCKET=
MEDIA_OBJECT_STORAGE_ACCESS_KEY_ID=
MEDIA_OBJECT_STORAGE_SECRET_ACCESS_KEY=
MEDIA_OBJECT_STORAGE_REGION=auto
MEDIA_OBJECT_STORAGE_ADDRESSING_STYLE=path
MEDIA_OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
MEDIA_OBJECT_STORAGE_READ_TIMEOUT_SECONDS=60
MEDIA_OBJECT_STORAGE_MAX_ATTEMPTS=3
MEDIA_OBJECT_STORAGE_MAX_UPLOAD_BYTES=1073741824
MEDIA_CDN_REQUIRED_ORIGINS=http://localhost:3000
# Local settings print verification emails to the backend console.
DJANGO_DEFAULT_FROM_EMAIL="Quran Platform <noreply@localhost>"
FEEDBACK_NOTIFICATION_EMAIL=operator@example.com
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
QF_AUDIO_SYNC_ENABLED=false
QF_AYAH_AUDIO_SYNC_ENABLED=false
QF_AYAH_AUDIO_EDITION=madani-hafs
QF_MUSHAF_SYNC_ENABLED=false
QF_TRANSLATION_SYNC_ENABLED=false
QF_TRANSLATION_RESOURCE_IDS=20,45,77
QF_AUDIO_REFRESH_DAYS=5
QF_AUDIO_STALE_AFTER_HOURS=168
# Long random bearer token used only by /api/v1/health/operations and /api/v1/metrics.
QURAN_OPERATIONS_TOKEN=replace-with-a-long-random-operations-token
LOG_LEVEL=INFO
